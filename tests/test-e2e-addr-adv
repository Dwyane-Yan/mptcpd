#! /bin/bash
. "${srcdir:-$(dirname "${0}")}/pm_lib.sh"

ep_has() {
	printf '%s\n' "${1}" | awk -v a="${2}" -v f="${3}" '
		{ for (i=1; i+3 <= NF; i++)
			if ($i==a && $(i+1)=="id" && $(i+3)==f) found=1 }
		END { exit !found }'
}

pm_ep_check() {
	if ep_has "${2}" "${3}" "${4}"; then
		pm_pass "${1}: ${3} ~ ${4}"
	else
		pm_fail "${1}: expected ${3} with ${4}"; fi
}

pm_test_addr_adv() {
	local ns1_ep
	local ns2_ep

	pm_start_mptcpd "${PM_NS1}" "addr_adv" "signal"
	pm_start_mptcpd "${PM_NS2}" "addr_adv" "subflow"

	wait_mptcp_endpoints "${PM_NS1}" 2 || pm_fail "endpoints missing in ${PM_NS1}"
	wait_mptcp_endpoints "${PM_NS2}" 2 || pm_fail "endpoints missing in ${PM_NS2}"

	ns1_ep="$(ip -net "${PM_NS1}" mptcp endpoint show)"
	ns2_ep="$(ip -net "${PM_NS2}" mptcp endpoint show)"

	pm_ep_check "${PM_NS1}" "${ns1_ep}" 10.0.1.1 signal
	pm_ep_check "${PM_NS1}" "${ns1_ep}" 10.0.2.1 signal
	pm_ep_check "${PM_NS2}" "${ns2_ep}" 10.0.1.2 subflow
	pm_ep_check "${PM_NS2}" "${ns2_ep}" 10.0.2.2 subflow

	pm_do_conn "0.0.0.0" "10.0.1.1" "5001"

	if wait_mptcp_subflows "${PM_NS1}" "5001" 2; then
		pm_pass "mptcp connection has ${SUBFLOWS} subflows (>=2)"
	else
		pm_fail "expected >=2 subflows, got ${SUBFLOWS:-0}"
	fi

	# --- CI_debug temporary probes: why does ss -M not show the msk? ---
	echo "=== probe: kernel/config ==="
	uname -r
	grep MPTCP /boot/config-"$(uname -r)" 2>/dev/null \
		|| zcat /proc/config.gz 2>/dev/null | grep MPTCP
	echo "=== probe: mptcp diag module ==="
	ls /lib/modules/"$(uname -r)"/kernel/net/mptcp/ 2>/dev/null \
		|| echo "no /lib/modules mptcp dir"
	lsmod | grep mptcp || echo "mptcp_diag not loaded"
	echo "=== probe: ss -M before modprobe ==="
	ip netns exec "${PM_NS1}" ss -H -M 2>&1 | head -3
	echo "=== probe: modprobe mptcp_diag ==="
	modprobe mptcp_diag 2>&1; echo "modprobe rc=$?"
	echo "=== probe: ss -Mit after modprobe ==="
	ip netns exec "${PM_NS1}" ss -Mit 2>&1 | head -8
}

pm_check_prereqs
pm_setup_env
pm_test_addr_adv
